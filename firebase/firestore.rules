rules_version = '2';

// Daanav – Cloud Firestore security rules
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
//
// Data layout:
//   users/{uid}                        small profile (name, email, joined, referral code)
//   users/{uid}/workouts/{workoutId}   one document per finished workout
//   users/{uid}/meta/state             custom exercises + workout in progress
//   config/app                         pricing, offer, referrals, general settings (Admin)
//   coupons/{CODE}                     coupon codes (Admin)
//
// Every signed-in person can read and write ONLY their own workouts.
// Only the admin email (verified) can change settings, manage coupons and list users.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && allowedUser();
    }

    // ---- Optional: only let specific emails use the app ----------------
    // By default anyone who creates an account can store their OWN workouts.
    // To make Daanav private to you (and friends), replace `true` below with
    // a list of emails, for example:
    //   return request.auth.token.email in ['you@gmail.com', 'friend@gmail.com'];
    function allowedUser() {
      return true;
    }

    // The one admin. Must match ADMIN_EMAIL in app.js. The email must be
    // verified (Google sign-in always is; email+password needs the link).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'aggarwalvishal904@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // App settings: everyone can read (prices, offers, announcement), only admin writes.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin() && docId == 'app';
    }

    // Coupons: a signed-in user can look up ONE code they typed; only admin can list or change.
    match /coupons/{code} {
      allow get: if request.auth != null;
      allow list, write: if isAdmin();
    }

    // Small profile per user, used for the admin Users list and referrals.
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'refCode', 'lastSeen', 'joined', 'referredBy'])
        && (resource == null || !('referredBy' in resource.data)
            || request.resource.data.referredBy == resource.data.referredBy);
    }

    match /users/{uid}/workouts/{workoutId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.date is string
        && request.resource.data.exercises is list
        && request.resource.data.parts is list;
    }

    match /users/{uid}/meta/{docId} {
      allow read, write: if isOwner(uid) && docId == 'state';
    }

    // Everything else is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
